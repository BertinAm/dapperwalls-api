# Copy to .env for local development. In production, set these in cPanel's
# "Setup Python App" screen (Passenger doesn't read a shell profile). A .env
# file in the app root is also loaded if present, but prefer cPanel.
# Real environment variables always win over values in .env.

# --- Core ---
# DEBUG defaults to False. Never True in production.
DEBUG=True
# Required when DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Comma-separated. Default: api.dapperwalls.co.uk (localhost is added when DEBUG=True)
ALLOWED_HOSTS=api.dapperwalls.co.uk
# Comma-separated. Default shown.
CSRF_TRUSTED_ORIGINS=https://dapperwalls.co.uk,https://www.dapperwalls.co.uk,https://api.dapperwalls.co.uk
# Comma-separated. Default shown. http://localhost:3000 and http://127.0.0.1:3000 are added when DEBUG=True.
CORS_ALLOWED_ORIGINS=https://dapperwalls.co.uk,https://www.dapperwalls.co.uk
# Path of the Django admin (no leading slash). Default: manage-dw/
ADMIN_URL=manage-dw/

# --- Database ---
# Default: SQLite file db.sqlite3 in the project root.
# Production (MySQL via PyMySQL): mysql://USER:PASSWORD@localhost:3306/DBNAME
# URL-encode special characters in the password.
DATABASE_URL=
# Seconds to keep DB connections open. Default: 60
DB_CONN_MAX_AGE=60

# --- Cloudflare proxy / client IP ---
# Shared secret the Cloudflare Pages Function sends as X-Proxy-Token.
# Required in production, at least 32 characters. Must match the Pages Function.
PROXY_SHARED_SECRET=
# META key of the header to trust for the client IP when there is no valid
# proxy token. Default: HTTP_CF_CONNECTING_IP. Leave empty to use REMOTE_ADDR only.
TRUSTED_IP_HEADER=HTTP_CF_CONNECTING_IP

# --- Enquiries ---
# Where new-enquiry notifications go. Comma-separated for several addresses.
# Default: support@dapperwalls.co.uk
ENQUIRY_NOTIFY_EMAIL=support@dapperwalls.co.uk
# Reply-To on the customer confirmation. Default: support@dapperwalls.co.uk
ENQUIRY_REPLY_TO_EMAIL=support@dapperwalls.co.uk
# Submissions faster than this (ms since the form opened) are silently dropped. Default: 2500
ENQUIRY_MIN_ELAPSED_MS=2500
# Per resolved client IP. Defaults: 5 per hour, 20 per day.
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=20

# --- Email (SMTP) ---
# Default backend: console when DEBUG=True, SMTP otherwise.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=DapperWalls <support@dapperwalls.co.uk>
# Sender for Django's own error emails. Default: DEFAULT_FROM_EMAIL
SERVER_EMAIL=
EMAIL_HOST=mail.example.com
# Default 465 (implicit SSL). For STARTTLS use 587 with EMAIL_USE_SSL=False, EMAIL_USE_TLS=True.
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
# Seconds. Default: 10
EMAIL_TIMEOUT=10

# --- Security ---
# HSTS max-age in seconds when DEBUG=False. Default: 31536000 (1 year, includes subdomains)
SECURE_HSTS_SECONDS=31536000
# Only set True once you've decided to submit the domain to the HSTS preload list.
SECURE_HSTS_PRELOAD=False

# --- Logging ---
# Logs always go to stderr (Passenger's stderr.log). Optionally also to a file.
LOG_LEVEL=INFO
LOG_FILE=

# --- Email links and images ---
# Absolute URLs used inside the emails. Defaults shown.
SITE_URL=https://dapperwalls.co.uk
API_PUBLIC_URL=https://api.dapperwalls.co.uk
# Where the email logo PNGs are hosted (the website's public/email/ folder).
EMAIL_ASSET_BASE_URL=https://dapperwalls.co.uk/email

# --- Cron ---
# Cron jobs don't receive the variables set in Setup Python App. Point
# ENV_FILE at a private file (outside the web folder) holding the same values:
#   ENV_FILE=/home/USER/.dapperwalls.env python manage.py send_pending_enquiry_emails
